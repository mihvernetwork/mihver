{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mihver.network/schemas/dev/shadow-decision-packet.schema.json","title":"ShadowDecisionPacket v1","type":"object","additionalProperties":false,"required":["packetHash","councilEpochId","seatId","seatRole","riskClass","taskId","decisionRequestId","contextHash","repositoryHead","decisionQuestion","evidence","outputContract"],"properties":{"packetHash":{"$ref":"#/$defs/hash"},"councilEpochId":{"$ref":"#/$defs/id"},"seatId":{"$ref":"#/$defs/id"},"seatRole":{"enum":["PROPOSER","REVIEWER"]},"riskClass":{"enum":["R0","R1","R2","R3","R4"]},"taskId":{"$ref":"#/$defs/id"},"decisionRequestId":{"$ref":"#/$defs/id"},"contextHash":{"$ref":"#/$defs/hash"},"repositoryHead":{"type":"string","pattern":"^[0-9a-f]{40}$"},"decisionQuestion":{"type":"string","minLength":1,"maxLength":2000},"evidence":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":1000}},"candidateHash":{"$ref":"#/$defs/hash"},"candidateDecision":{"$ref":"https://mihver.network/schemas/dev/decision-council.schema.json#/$defs/CandidateDecision"},"outputContract":{"type":"object","additionalProperties":false,"required":["artifact","requiredFields","jsonOnly"],"properties":{"artifact":{"enum":["AgentProposal","AgentVote"]},"requiredFields":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"string","minLength":1,"maxLength":100}},"jsonOnly":{"const":true}}}},"dependentRequired":{"candidateHash":["candidateDecision"],"candidateDecision":["candidateHash"]},"allOf":[{"if":{"properties":{"outputContract":{"properties":{"artifact":{"const":"AgentVote"}},"required":["artifact"]}},"required":["outputContract"]},"then":{"required":["candidateHash","candidateDecision"]}}],"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"id":{"type":"string","minLength":1,"maxLength":200}}}
