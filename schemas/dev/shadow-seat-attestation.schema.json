{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mihver.network/schemas/dev/shadow-seat-attestation.schema.json","title":"ShadowSeatAttestation v1","type":"object","additionalProperties":false,"required":["attestationHash","seatId","councilEpochId","provider","requestedModelId","cliExecutableRealpath","cliVersion","childProcessId","invocationConfigHash","packetHash","outputHash","exitCode","reportedModelId","modelUsage","observedToolUsage","residualTrustLimitation"],"properties":{"attestationHash":{"$ref":"#/$defs/hash"},"seatId":{"type":"string","minLength":1},"councilEpochId":{"type":"string","minLength":1},"provider":{"enum":["openai","anthropic","google"]},"requestedModelId":{"type":"string","minLength":1},"cliExecutableRealpath":{"type":"string","minLength":1},"cliVersion":{"type":"string","minLength":1},"childProcessId":{"type":"integer","minimum":0},"invocationConfigHash":{"$ref":"#/$defs/hash"},"packetHash":{"$ref":"#/$defs/hash"},"outputHash":{"$ref":"#/$defs/hash"},"exitCode":{"type":"integer"},"reportedModelId":{"type":["string","null"]},"modelUsage":{"type":"object","additionalProperties":{"type":"object"}},"observedToolUsage":{"type":"array","maxItems":50,"items":{"type":"string","minLength":1,"maxLength":200}},"residualTrustLimitation":{"const":"One parent harness process controls all three child-process launches; this attestation demonstrates local runtime/process separation between seat adapters only, not cryptographic provider non-collusion."},"cliExecutableContentHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"providerSessionId":{"type":["string","null"],"maxLength":512},"usageMetadata":{"type":["object","null"]}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
