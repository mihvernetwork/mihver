{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mihver.network/schemas/dev/task-record.schema.json",
  "title": "MIHVER TaskRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "objective", "branch", "baseCommit", "allowedScope", "disposition", "unresolvedRisks", "humanActionRequested", "taskRecordHash"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "branch": { "type": "string", "minLength": 1, "maxLength": 512 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "allowedScope": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "forbiddenScope": { "type": "array", "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "disposition": { "enum": ["IN_PROGRESS", "COMPLETE_PENDING_HUMAN_REVIEW", "BLOCKED"] },
    "unresolvedRisks": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "humanActionRequested": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "taskRecordHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
