{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mihver.network/schemas/m0/user-idea.schema.json",
  "title": "MIHVER M0 UserIdea",
  "description": "A single immutable, cumulative version of exactly what a user supplied. Cross-version immutability and semantic faithfulness require validation outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "idea_id", "version", "source", "created_at", "turns", "supersessions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "user_idea" },
    "idea_id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "description": "Stable source identity for every turn in this UserIdea version. The deterministic validator requires each turn source_id to match it.",
      "additionalProperties": false,
      "required": ["source_id", "channel"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "channel": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn" }
    },
    "supersessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/supersession" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "sequence", "supplied_at", "source_id", "source_language", "contents"],
      "properties": {
        "turn_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "supplied_at": { "type": "string", "format": "date-time" },
        "source_id": { "$ref": "#/$defs/id" },
        "source_language": {
          "description": "Authoritative source language for this turn; different turns may use different languages.",
          "$ref": "#/$defs/language"
        },
        "contents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/content" } }
      }
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "media_type", "content_base64", "content_digest", "description"],
          "properties": {
            "kind": { "const": "attachment" },
            "media_type": { "type": "string", "minLength": 1 },
            "content_base64": { "type": "string", "contentEncoding": "base64" },
            "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": { "const": "external_reference" },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "original_modality"],
          "properties": {
            "kind": { "const": "transcription" },
            "text": { "type": "string", "minLength": 1 },
            "original_modality": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["superseding_turn_id", "superseded_turn_id", "explicit_signal_quote"],
      "properties": {
        "superseding_turn_id": { "$ref": "#/$defs/id" },
        "superseded_turn_id": { "$ref": "#/$defs/id" },
        "explicit_signal_quote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
